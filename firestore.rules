rules_version = '2';

// GaadiKhata Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Each signed-in user can read and write only their own tree:
//   users/{uid}/vehicles/{vehicleId}/(fuelEntries | serviceRecords | recommendations | challans)
//   users/{uid}/documents/{docId}/file/(content | back | page3 | page4)
// The owner can also read users/{uid} (name, email and counts for the admin page),
// but never anything below it. Everything else is denied. Writes are also checked for the right fields,
// types and sensible ranges, so a modified browser cannot store junk.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'VAKGsSOEI4TFHEyuZSsZ53SL1262';
    }

    function count(d, key) {
      return !(key in d) || (d[key] is int && d[key] >= 0 && d[key] <= 100000);
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function optionalString(d, key, max) {
      return !(key in d) || d[key] == null || shortString(d[key], max);
    }

    function validUser(d) {
      return d.keys().hasOnly(['createdAt', 'updatedAt', 'name', 'email', 'vehicleCount', 'twoWheelers', 'fourWheelers',
                               'fuelCount', 'scanCount', 'serviceCount', 'documentCount', 'appVersion', 'device', 'installed'])
        && optionalString(d, 'createdAt', 40)
        && optionalString(d, 'updatedAt', 40)
        && optionalString(d, 'name', 120) && optionalString(d, 'email', 200)
        && optionalString(d, 'appVersion', 20) && optionalString(d, 'device', 20)
        && (!('installed' in d) || d.installed is bool)
        && count(d, 'vehicleCount') && count(d, 'twoWheelers') && count(d, 'fourWheelers')
        && count(d, 'fuelCount') && count(d, 'scanCount') && count(d, 'serviceCount') && count(d, 'documentCount');
    }

    function validVehicle(d, vehicleId) {
      return d.keys().hasAll(['id', 'nickname', 'type', 'fuelType', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'nickname', 'type', 'make', 'model', 'registration', 'fuelType',
                             'initialOdometer', 'reminderSettings', 'demo', 'createdAt', 'updatedAt'])
        && (!('reminderSettings' in d) || d.reminderSettings is map)
        && d.id == vehicleId
        && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 40
        && d.type in ['two', 'four']
        && d.fuelType in ['petrol', 'diesel', 'cng', 'electric']
        && (!('initialOdometer' in d) || d.initialOdometer == null || (d.initialOdometer is number && d.initialOdometer >= 0 && d.initialOdometer <= 9999999))
        && optionalString(d, 'make', 120)
        && optionalString(d, 'model', 120)
        && optionalString(d, 'registration', 120)
        && (!('demo' in d) || d.demo is bool)
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validEntry(d, vehicleId, entryId) {
      return d.keys().hasAll(['id', 'vehicleId', 'date', 'quantity', 'totalAmount', 'fullTank', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'date', 'quantity', 'unit', 'pricePerUnit', 'totalAmount',
                             'station', 'odometer', 'fullTank', 'notes', 'calculated', 'demo',
                             'createdAt', 'updatedAt', 'time', 'fuelCompany', 'location',
                             'receiptNumber', 'dashboardRangeKm', 'source'])
        && d.id == entryId
        && d.vehicleId == vehicleId
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000
        && d.totalAmount is number && d.totalAmount > 0 && d.totalAmount <= 1000000
        && (!('odometer' in d) || d.odometer == null || (d.odometer is number && d.odometer > 0 && d.odometer <= 9999999))
        && d.fullTank is bool
        && (!('pricePerUnit' in d) || d.pricePerUnit == null || (d.pricePerUnit is number && d.pricePerUnit > 0))
        && (!('unit' in d) || d.unit in ['L', 'kg', 'kWh'])
        && optionalString(d, 'station', 120)
        && optionalString(d, 'notes', 500)
        && (!('calculated' in d) || (d.calculated is list && d.calculated.size() <= 3))
        && (!('demo' in d) || d.demo is bool)
        && optionalString(d, 'time', 5)
        && optionalString(d, 'fuelCompany', 120)
        && optionalString(d, 'location', 200)
        && optionalString(d, 'receiptNumber', 40)
        && (!('dashboardRangeKm' in d) || d.dashboardRangeKm == null || (d.dashboardRangeKm is number && d.dashboardRangeKm >= 0))
        && (!('source' in d) || d.source in ['manual', 'smart', 'smart-demo'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validService(d, vehicleId, serviceId) {
      return d.keys().hasAll(['id', 'vehicleId', 'serviceDate', 'serviceType', 'items', 'financialSummary', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'serviceDate', 'jobCardDate', 'invoiceNumber', 'jobCardNumber',
                             'serviceCentre', 'serviceCentreLocation', 'serviceType', 'odometerKm', 'paymentMethod',
                             'warranty', 'vinLast4', 'notes', 'items', 'financialSummary', 'pageCount', 'source',
                             'extractionMetadata', 'demo', 'createdAt', 'updatedAt'])
        && d.id == serviceId
        && d.vehicleId == vehicleId
        && d.serviceDate is string && d.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.serviceType in ['free', 'paid', 'general', 'periodic', 'repair', 'breakdown', 'accident', 'other']
        && (!('odometerKm' in d) || d.odometerKm == null || (d.odometerKm is number && d.odometerKm >= 0 && d.odometerKm <= 9999999))
        && d.items is list && d.items.size() <= 200
        && d.financialSummary is map
        && (!('pageCount' in d) || (d.pageCount is int && d.pageCount >= 0 && d.pageCount <= 10))
        && (!('vinLast4' in d) || d.vinLast4 == null || (d.vinLast4 is string && d.vinLast4.size() <= 6))
        && optionalString(d, 'invoiceNumber', 120) && optionalString(d, 'jobCardNumber', 120)
        && optionalString(d, 'serviceCentre', 120) && optionalString(d, 'serviceCentreLocation', 120)
        && optionalString(d, 'paymentMethod', 120) && optionalString(d, 'warranty', 120)
        && optionalString(d, 'jobCardDate', 120) && optionalString(d, 'notes', 500)
        && (!('source' in d) || d.source in ['manual', 'smart', 'smart-demo'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validRecommendation(d, vehicleId, recId) {
      return d.keys().hasAll(['id', 'vehicleId', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'serviceRecordId', 'status', 'dueDate', 'dueKm', 'serviceCentre',
                             'notes', 'source', 'completedAt', 'completedByServiceId', 'createdAt', 'updatedAt'])
        && d.id == recId
        && d.vehicleId == vehicleId
        && d.status in ['recommended', 'not-recommended', 'not-mentioned']
        && (!('dueDate' in d) || d.dueDate == null || (d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('dueKm' in d) || d.dueKm == null || (d.dueKm is number && d.dueKm > 0 && d.dueKm <= 9999999))
        && optionalString(d, 'serviceRecordId', 60) && optionalString(d, 'serviceCentre', 120) && optionalString(d, 'notes', 500)
        && optionalString(d, 'completedAt', 40) && optionalString(d, 'completedByServiceId', 60)
        && (!('source' in d) || d.source in ['invoice', 'manual'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validChallan(d, vehicleId, challanId) {
      return d.keys().hasAll(['id', 'vehicleId', 'date', 'amount', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'date', 'amount', 'status', 'paidDate', 'offence', 'challanNumber',
                             'location', 'notes', 'source', 'createdAt', 'updatedAt'])
        && d.id == challanId
        && d.vehicleId == vehicleId
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.amount is number && d.amount > 0 && d.amount <= 500000
        && d.status in ['paid', 'unpaid']
        && (!('paidDate' in d) || d.paidDate == null || (d.paidDate is string && d.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && optionalString(d, 'offence', 160) && optionalString(d, 'challanNumber', 60)
        && optionalString(d, 'location', 160) && optionalString(d, 'notes', 500)
        && (!('source' in d) || d.source in ['manual', 'photo'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function extraImage(d, nameKey, typeKey, sizeKey) {
      return optionalString(d, nameKey, 120)
        && (!(typeKey in d) || d[typeKey] in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'])
        && (!(sizeKey in d) || (d[sizeKey] is int && d[sizeKey] > 0 && d[sizeKey] <= 1000000));
    }

    function validDocument(d, docId) {
      return d.keys().hasAll(['id', 'type', 'fileName', 'mimeType', 'fileSize', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'type', 'title', 'expiryDate', 'fileName', 'mimeType', 'fileSize',
                             'backFileName', 'backMimeType', 'backFileSize', 'page3FileName', 'page3MimeType', 'page3FileSize',
                             'page4FileName', 'page4MimeType', 'page4FileSize', 'createdAt', 'updatedAt'])
        && d.id == docId
        && optionalString(d, 'vehicleId', 60)
        && d.type in ['rc', 'insurance', 'puc', 'licence', 'medical', 'other']
        && optionalString(d, 'title', 60)
        && (!('expiryDate' in d) || d.expiryDate == null || (d.expiryDate is string && d.expiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && shortString(d.fileName, 120)
        && d.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && d.fileSize is int && d.fileSize > 0 && d.fileSize <= 1000000
        && extraImage(d, 'backFileName', 'backMimeType', 'backFileSize')
        && extraImage(d, 'page3FileName', 'page3MimeType', 'page3FileSize')
        && extraImage(d, 'page4FileName', 'page4MimeType', 'page4FileSize')
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validDocumentFile(d) {
      return d.keys().hasOnly(['data', 'mimeType'])
        && d.keys().hasAll(['data', 'mimeType'])
        && d.data is bytes && d.data.size() > 0 && d.data.size() <= 1000000
        && d.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      // Copies of RC, insurance, licence and so on: details, then the file (loaded only when opened).
      match /documents/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDocument(request.resource.data, docId);

        match /file/{fileId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && fileId in ['content', 'back', 'page3', 'page4'] && validDocumentFile(request.resource.data);
        }
      }

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validVehicle(request.resource.data, vehicleId);

        match /fuelEntries/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validEntry(request.resource.data, vehicleId, entryId);
        }

        match /challans/{challanId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validChallan(request.resource.data, vehicleId, challanId);
        }

        match /recommendations/{recId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validRecommendation(request.resource.data, vehicleId, recId);
        }

        match /serviceRecords/{serviceId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validService(request.resource.data, vehicleId, serviceId);

          // Compressed invoice page images (JPEG data URLs, kept under Firestore's 1 MB document limit).
          match /pages/{pageId} {
            allow read, delete: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && request.resource.data.keys().hasOnly(['index', 'dataUrl'])
              && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < 10
              && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 900000;
          }
        }
      }
    }
  }
}
