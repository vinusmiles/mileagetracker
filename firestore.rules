rules_version = '2';

// MileageMate Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Each signed-in user can read and write only their own tree:
//   users/{uid}/vehicles/{vehicleId}/fuelEntries/{entryId}
// Everything else is denied. Writes are also checked for the right fields,
// types and sensible ranges, so a modified browser cannot store junk.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function optionalString(d, key, max) {
      return !(key in d) || d[key] == null || shortString(d[key], max);
    }

    function validUser(d) {
      return d.keys().hasOnly(['createdAt', 'updatedAt'])
        && optionalString(d, 'createdAt', 40)
        && optionalString(d, 'updatedAt', 40);
    }

    function validVehicle(d, vehicleId) {
      return d.keys().hasAll(['id', 'nickname', 'type', 'fuelType', 'initialOdometer', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'nickname', 'type', 'make', 'model', 'registration', 'fuelType',
                             'initialOdometer', 'demo', 'createdAt', 'updatedAt'])
        && d.id == vehicleId
        && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 40
        && d.type in ['two', 'four']
        && d.fuelType in ['petrol', 'diesel', 'cng', 'electric']
        && d.initialOdometer is number && d.initialOdometer >= 0 && d.initialOdometer <= 9999999
        && optionalString(d, 'make', 120)
        && optionalString(d, 'model', 120)
        && optionalString(d, 'registration', 120)
        && (!('demo' in d) || d.demo is bool)
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validEntry(d, vehicleId, entryId) {
      return d.keys().hasAll(['id', 'vehicleId', 'date', 'quantity', 'totalAmount', 'odometer', 'fullTank', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'date', 'quantity', 'unit', 'pricePerUnit', 'totalAmount',
                             'station', 'odometer', 'fullTank', 'notes', 'calculated', 'demo',
                             'createdAt', 'updatedAt', 'time', 'fuelCompany', 'location',
                             'receiptNumber', 'dashboardRangeKm', 'source'])
        && d.id == entryId
        && d.vehicleId == vehicleId
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.quantity is number && d.quantity > 0 && d.quantity <= 1000
        && d.totalAmount is number && d.totalAmount > 0 && d.totalAmount <= 1000000
        && d.odometer is number && d.odometer > 0 && d.odometer <= 9999999
        && d.fullTank is bool
        && (!('pricePerUnit' in d) || d.pricePerUnit == null || (d.pricePerUnit is number && d.pricePerUnit > 0))
        && (!('unit' in d) || d.unit in ['L', 'kg', 'kWh'])
        && optionalString(d, 'station', 120)
        && optionalString(d, 'notes', 500)
        && (!('calculated' in d) || (d.calculated is list && d.calculated.size() <= 3))
        && (!('demo' in d) || d.demo is bool)
        && optionalString(d, 'time', 5)
        && optionalString(d, 'fuelCompany', 120)
        && optionalString(d, 'location', 200)
        && optionalString(d, 'receiptNumber', 40)
        && (!('dashboardRangeKm' in d) || d.dashboardRangeKm == null || (d.dashboardRangeKm is number && d.dashboardRangeKm >= 0))
        && (!('source' in d) || d.source in ['manual', 'smart', 'smart-demo'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    function validService(d, vehicleId, serviceId) {
      return d.keys().hasAll(['id', 'vehicleId', 'serviceDate', 'serviceType', 'items', 'financialSummary', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'vehicleId', 'serviceDate', 'jobCardDate', 'invoiceNumber', 'jobCardNumber',
                             'serviceCentre', 'serviceCentreLocation', 'serviceType', 'odometerKm', 'paymentMethod',
                             'warranty', 'vinLast4', 'notes', 'items', 'financialSummary', 'pageCount', 'source',
                             'extractionMetadata', 'demo', 'createdAt', 'updatedAt'])
        && d.id == serviceId
        && d.vehicleId == vehicleId
        && d.serviceDate is string && d.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.serviceType in ['free', 'paid', 'general', 'periodic', 'repair', 'breakdown', 'accident', 'other']
        && (d.odometerKm == null || (d.odometerKm is number && d.odometerKm >= 0 && d.odometerKm <= 9999999))
        && d.items is list && d.items.size() <= 200
        && d.financialSummary is map
        && (!('pageCount' in d) || (d.pageCount is int && d.pageCount >= 0 && d.pageCount <= 10))
        && (!('vinLast4' in d) || d.vinLast4 == null || (d.vinLast4 is string && d.vinLast4.size() <= 6))
        && optionalString(d, 'invoiceNumber', 120) && optionalString(d, 'jobCardNumber', 120)
        && optionalString(d, 'serviceCentre', 120) && optionalString(d, 'serviceCentreLocation', 120)
        && optionalString(d, 'paymentMethod', 120) && optionalString(d, 'warranty', 120)
        && optionalString(d, 'jobCardDate', 120) && optionalString(d, 'notes', 500)
        && (!('source' in d) || d.source in ['manual', 'smart', 'smart-demo'])
        && shortString(d.createdAt, 40) && shortString(d.updatedAt, 40);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validVehicle(request.resource.data, vehicleId);

        match /fuelEntries/{entryId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validEntry(request.resource.data, vehicleId, entryId);
        }

        match /serviceRecords/{serviceId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validService(request.resource.data, vehicleId, serviceId);

          // Compressed invoice page images (JPEG data URLs, kept under Firestore's 1 MB document limit).
          match /pages/{pageId} {
            allow read, delete: if isOwner(uid);
            allow create, update: if isOwner(uid)
              && request.resource.data.keys().hasOnly(['index', 'dataUrl'])
              && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < 10
              && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 900000;
          }
        }
      }
    }
  }
}
